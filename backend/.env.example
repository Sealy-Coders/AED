# MongoDB (docker compose up -d mongodb)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=aed_map
MONGO_COLLECTION_NAME=aed

# GeoJSON gmin (JPT_KOD_JE / JPT_NAZWA_) — używany przez seed_db.py do
# przypisania TERYT oraz przez /api/gminy jako geometria. Ścieżka względna
# liczona od katalogu backend/.
GMINY_GEOJSON_PATH=../frontend/public/geojson/gminy.json

# Dozwolone originy frontendu (CORS), rozdzielone przecinkami
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
